{
  "manifest_version": 3,
  "name": "YouTube Auto CC",
  "version": "0.1.0",
  "description": "Auto-enables auto-generated closed captions on every YouTube video.",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
