{
  "manifest_version": 3,
  "name": "YouTube Auto-Generated CC",
  "version": "0.1.0",
  "description": "Automatically turns on YouTube's auto-generated closed captions in the video's original language on every video.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
